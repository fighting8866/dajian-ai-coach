# Board vision only demo config
# Copy into backend/.env or merge into your existing backend/.env.

ASCEND_BASE_URL=http://192.168.1.100:18081

VISION_PROVIDER=ascend
SPEECH_PROVIDER=local
PPT_PROVIDER=local
QA_PROVIDER=local
QUESTION_PROVIDER=rule
FOLLOWUP_PROVIDER=rule
COMMENTARY_PROVIDER=rule

# Optional. Keep defaults unless board service changed its route.
# ASCEND_VISION_ENDPOINT=/vision/analyze
# ASCEND_SPEECH_ENDPOINT=/speech/analyze

# 经主后端转发时含「本机→板」整段上传与推理，默认已在 config 中放宽到 300s；若仍偶发超时可再提高。
ASCEND_VISION_TIMEOUT_SECONDS=300
# ASCEND_TIMEOUT_SECONDS=20

# Optional sampling knobs, read by the board vision service.
# VISION_TARGET_ANALYSIS_FPS=1.0
# VISION_MAX_ANALYSIS_FRAMES=240

# Production secret, unrelated to board routing.
# JWT_SECRET=your-strong-secret
